---
/**
 * Static DOM for /brain: canvas host, hub and case labels, big region name, memory cards,
 * header, hint and the panel with every region and case rendered as hidden articles.
 * brain.ts only positions things and toggles visibility.
 */
import data from '../../data/brain.json';
import { url } from '../../lib/url';

const { regions, workCases } = data;
const n = regions.length;
const m = workCases.length;

/** brain.json links are site-root relative: add the base and the trailing slash Astro uses. */
const href = (path: string) => {
  const [p, hash] = path.split('#');
  const withSlash = p && !p.endsWith('/') && !/\.\w+$/.test(p) ? p + '/' : p || '/';
  return url(withSlash) + (hash ? '#' + hash : '');
};
---
<div class="brain" data-brain>
  <div class="host" data-host aria-hidden="true"></div>

  <div class="labels">
    {regions.map((r, i) => (
      <button type="button" class="hub" data-hub={i} aria-label={`${r.num} ${r.name}: open`}>
        <span class="n">{r.num}</span><span>{r.name}</span>
      </button>
    ))}
    {workCases.map((c, k) => (
      <button type="button" class="sub" data-sub={k} tabindex="-1">
        <span class="n">{c.num}</span><span>{c.name}</span>
      </button>
    ))}
  </div>

  <p class="bigname head" data-bigname aria-hidden="true"></p>

  <div class="memories" aria-hidden="true">
    <svg class="memlines">
      {regions.map((r) => r.memories.map((_, k) => (
        <line data-memline data-region={r.id} data-k={k} x1="0" y1="0" x2="0" y2="0" opacity="0" />
      )))}
    </svg>
    {regions.map((r) => r.memories.map((mem, k) => mem.image && (
      <figure class="mem" data-mem data-region={r.id} data-k={k}>
        <img src={url(mem.image)} alt="" loading="lazy" />
        <figcaption>{mem.caption}</figcaption>
      </figure>
    )))}
  </div>

  <header class="top">
    <div class="who">
      <p class="name head">Anna Shevchenko</p>
      <p class="intro" data-intro>A 3D map of my work, studies and life outside them. Select a region to look inside.</p>
    </div>
    <a class="back" href={url('/')}>← Portfolio</a>
  </header>

  <p class="hint">Drag to rotate · Select a region</p>

  <aside class="panel" data-panel role="dialog" aria-modal="false" hidden>
    {regions.map((r, i) => (
      <article data-view={`r${i}`} hidden>
        <div class="crumb-row">
          <p class="crumb">{r.num} · {r.name}</p>
          <button type="button" class="close" data-close aria-label="Close">×</button>
        </div>
        <div class="titles">
          <p class="kicker">{r.kicker}</p>
          <h2 class="head" id={`brain-r${i}`} tabindex="-1">{r.title}</h2>
          <p class="meta">{r.meta}</p>
        </div>
        {'image' in r && r.image && <img class="shot" src={url(r.image)} alt={r.imageAlt} loading="lazy" />}
        <p class="body">{r.body}</p>
        {r.id === 'work' && (
          <div class="cases">
            <p class="cases-label">Case studies</p>
            {workCases.map((c, k) => (
              <button type="button" class="row" data-go={`c${k}`}>
                <span class="row-name"><span class="n">{c.num}</span><span>{c.name}</span></span><span>→</span>
              </button>
            ))}
          </div>
        )}
        <div class="links">
          {r.links.map((l) => <a class="row" href={href(l.href)}><span>{l.label}</span><span>→</span></a>)}
        </div>
        <div class="foot">
          <button type="button" data-go={`r${(i - 1 + n) % n}`}>← {regions[(i - 1 + n) % n].name}</button>
          <button type="button" data-go={`r${(i + 1) % n}`}>{regions[(i + 1) % n].name} →</button>
        </div>
      </article>
    ))}
    {workCases.map((c, k) => (
      <article data-view={`c${k}`} hidden>
        <div class="crumb-row">
          <p class="crumb">{c.num} · Work / {c.name}</p>
          <button type="button" class="close" data-close aria-label="Close">×</button>
        </div>
        <div class="titles">
          <p class="kicker">{c.kicker}</p>
          <h2 class="head" id={`brain-c${k}`} tabindex="-1">{c.title}</h2>
          <p class="meta">{c.meta}</p>
        </div>
        {c.image && <img class="shot" src={url(c.image)} alt={c.imageAlt ?? ''} loading="lazy" />}
        <p class="body">{c.body}</p>
        <div class="links">
          <a class="row" href={href(c.href)}><span>Read the case</span><span>→</span></a>
        </div>
        <div class="foot">
          <button type="button" data-go="r0">← Work</button>
          <button type="button" data-go={`c${(k + 1) % m}`}>{workCases[(k + 1) % m].name} →</button>
        </div>
      </article>
    ))}
  </aside>
</div>

<style>
  .brain { position: fixed; inset: 0; overflow: hidden; background: var(--brain-bg); color: var(--brain-text); font-family: var(--font-body); }
  .brain :global(a:hover) { color: var(--brain-hover); }
  .host { position: absolute; inset: 0; cursor: grab; touch-action: none; }
  .host :global(canvas) { display: block; }

  /* labels */
  .labels, .memories { position: absolute; inset: 0; pointer-events: none; }
  .hub, .sub {
    position: absolute; left: 0; top: 0; opacity: 0; pointer-events: none;
    display: flex; align-items: center; gap: .6rem;
    border: 1px solid var(--brain-border); border-radius: 2px;
    font: 400 .72rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .09em;
    color: var(--brain-text); white-space: nowrap; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    transition: border-color .2s, background .2s;
  }
  .hub { padding: .5rem .75rem .5rem .6rem; background: var(--brain-chip); }
  .sub { gap: .5rem; padding: .4rem .6rem; background: var(--brain-chip-sub); border-color: var(--brain-border-soft); font-size: .66rem; letter-spacing: .08em; }
  .hub:hover, .sub:hover, .hub:focus-visible, .sub:focus-visible, .sub.on { border-color: var(--brain-hover); background: var(--brain-chip-hover); outline: none; }
  .hub:focus-visible { opacity: 1 !important; }
  .n { color: var(--brain-accent); }

  /* big region name */
  .bigname {
    position: absolute; left: clamp(1.25rem, 4vw, 3rem); bottom: 3.75rem; margin: 0;
    font-size: clamp(4.5rem, 12vw, 11rem); line-height: .8; letter-spacing: -.01em;
    color: transparent; -webkit-text-stroke: 1px var(--brain-stroke);
    pointer-events: none; opacity: 0; transition: opacity .8s;
  }
  .bigname.on { opacity: 1; }

  /* memory cards */
  .memlines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .memlines line { stroke: var(--brain-accent); stroke-width: 1; stroke-dasharray: 3 5; }
  .mem {
    position: absolute; left: 0; top: 0; margin: 0; display: none;
    padding: 7px 7px 0; background: var(--brain-card); box-shadow: var(--brain-card-shadow);
    opacity: 0; pointer-events: auto; transition: box-shadow .2s;
  }
  .mem.on { display: block; }
  .mem:hover { box-shadow: var(--brain-card-shadow-hover); }
  .mem img { width: 100%; aspect-ratio: 4 / 3; display: block; object-fit: cover; background: var(--brain-card-img); }
  .mem figcaption { padding: .55rem .15rem .65rem; font: 400 .64rem/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--print); }

  /* header + hint */
  .top { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 4vw, 3rem); pointer-events: none; }
  .who { display: flex; flex-direction: column; gap: .8rem; }
  .name { margin: 0; font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: -.01em; }
  .intro { margin: 0; max-width: 34ch; font: 300 .76rem/1.6 var(--font-mono); color: var(--brain-hover); text-wrap: pretty; transition: opacity .4s; }
  .intro.off { opacity: 0; }
  .back { pointer-events: auto; flex-shrink: 0; display: inline-flex; align-items: center; gap: .5rem; padding-bottom: .3rem; border-bottom: 1px solid currentColor; font: 500 .74rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; }
  .hint { position: absolute; left: clamp(1.25rem, 4vw, 3rem); bottom: clamp(1.25rem, 3vw, 2.25rem); margin: 0; font: 300 .72rem/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; color: var(--brain-hint); pointer-events: none; }

  /* panel */
  .panel {
    position: absolute; top: 0; right: 0; bottom: 0; width: min(440px, 38vw); overflow-y: auto;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--brain-panel); border-left: 1px solid var(--brain-border-soft); border-top: 1px solid var(--brain-border-soft);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .panel[hidden], article[hidden] { display: none; }
  article { min-height: 100%; display: flex; flex-direction: column; gap: 1.5rem; }
  article > * { margin: 0; }
  .crumb-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .crumb { margin: 0; font: 400 .74rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; color: var(--brain-accent); }
  .close { width: 2.5rem; height: 2.5rem; flex: 0 0 auto; display: grid; place-items: center; background: none; border: 1px solid var(--brain-border); border-radius: 2px; font: 400 1rem/1 var(--font-mono); color: var(--brain-text); }
  .close:hover { border-color: var(--brain-hover); }
  .titles { display: flex; flex-direction: column; gap: .9rem; }
  .titles > * { margin: 0; }
  .kicker { font: 300 .78rem/1.6 var(--font-mono); color: var(--brain-text-mute); }
  .titles h2 { font-size: clamp(2rem, 3.4vw, 3rem); outline: none; }
  .meta { font: 300 .78rem/1.6 var(--font-mono); color: var(--brain-accent); }
  .shot { width: 100%; aspect-ratio: 16 / 10; display: block; object-fit: cover; object-position: center top; border: 1px solid var(--brain-border-soft); background: var(--brain-deep); }
  .body { font-size: 1.02rem; line-height: 1.7; color: var(--brain-text-soft); text-wrap: pretty; }
  .cases, .links { display: flex; flex-direction: column; }
  .cases-label { margin: 0 0 .5rem; font: 400 .72rem/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; color: var(--brain-text-faint); }
  .row {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0;
    background: none; border: 0; border-top: 1px solid var(--brain-border-soft); text-align: left; color: var(--brain-text);
    font: 500 .76rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .08em;
  }
  .row:hover { color: var(--brain-hover); }
  .row-name { display: flex; gap: .9rem; }
  .foot { margin-top: auto !important; display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--brain-border-soft); }
  .foot button { background: none; border: 0; padding: .5rem 0; font: 400 .72rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; color: var(--brain-text-mute); }
  .foot button:hover { color: var(--white); }

  @media (max-width: 719.98px) {
    .panel { top: 45%; width: 100%; }
    .mem, .memlines { display: none !important; }
  }

  /* no WebGL: the panels become a plain list */
  .brain.no-gl { overflow-y: auto; }
  .no-gl .host, .no-gl .labels, .no-gl .hint, .no-gl .memories, .no-gl .bigname, .no-gl .intro { display: none; }
  .no-gl .top { position: static; }
  .no-gl .panel { position: static; width: auto; max-width: 44rem; margin: 0 auto; padding-top: 0; overflow: visible; background: none; border: 0; backdrop-filter: none; }
  .no-gl article[data-view^="r"] { display: flex; min-height: 0; padding: 2.5rem 0; border-top: 1px solid var(--brain-border-soft); }
  .no-gl .close, .no-gl .foot, .no-gl .cases { display: none; }
</style>
