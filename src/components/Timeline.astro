---
/** Vertical phase timeline; the last phase is drawn hollow (it repeats). */
interface Props { items: { label: string; title: string; text: string }[] }
const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((item) => (
    <li>
      <span class="track" aria-hidden="true"><span class="dot"></span><span class="line"></span></span>
      <div class="content">
        <p class="label">{item.label}</p>
        <p class="title">{item.title}</p>
        <p class="text">{item.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  li { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; }
  .track { display: flex; flex-direction: column; align-items: center; }
  .dot { width: .8rem; height: .8rem; margin-top: .4rem; border-radius: 50%; background: var(--accent); }
  .line { flex: 1; width: 1px; background: var(--line); }
  li:last-child .dot { background: transparent; border: 1px solid var(--accent); }
  li:last-child .line { display: none; }
  .content { padding-bottom: 1.75rem; }
  li:last-child .content { padding-bottom: 0; }
  p { margin: 0; }
  .label { font-size: .72rem; color: var(--fg-soft); }
  :global(.print) .label { color: var(--fg-soft); }
  .title { margin-top: .4rem; font-size: 1.2rem; font-weight: 500; letter-spacing: -.02em; }
  .text { margin-top: .4rem; font-size: .95rem; line-height: 1.6; color: var(--fg-body); }
</style>
