---
import { url } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  /** Bold mono line above the caption. */
  label?: string;
  caption?: string;
  /**
   * plain: hairline border · matte: pale cobalt mat · white: white mat (diagrams)
   * contain: 4:3 pale mat with the image contained · phone: narrow screen, no frame
   */
  variant?: 'plain' | 'matte' | 'white' | 'contain' | 'phone';
  /** Max width of the image inside its mat. */
  imgMax?: string;
  /** Cover figure: slightly larger caption. */
  cover?: boolean;
  eager?: boolean;
}
const { src, alt, label, caption, variant = 'plain', imgMax, cover = false, eager = false } = Astro.props;
---
<figure class:list={['figure', `f-${variant}`, { cover }]}>
  {variant === 'plain' || variant === 'phone' ? (
    <img src={url(src)} alt={alt} loading={eager ? undefined : 'lazy'} style={imgMax ? `max-width: ${imgMax}` : undefined} />
  ) : (
    <div class="mat"><img src={url(src)} alt={alt} loading={eager ? undefined : 'lazy'} style={imgMax ? `max-width: ${imgMax}` : undefined} /></div>
  )}
  {(label || caption) && (
    <figcaption class="caption">
      {label && <span class="fig-label">{label}</span>}
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .figure { margin: 0; min-width: 0; }
  img { width: 100%; display: block; }
  .f-plain img { border: 1px solid var(--line); }
  .mat { border: 1px solid var(--line); }
  .f-matte .mat { padding: clamp(.75rem, 1.5vw, 1.25rem); background: var(--matte); }
  .f-white .mat { padding: clamp(1rem, 2vw, 1.75rem); background: var(--white); }
  .f-matte img, .f-white img { margin-inline: auto; }
  .f-contain .mat { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; padding: clamp(1rem, 2vw, 1.5rem); background: var(--matte); }
  .f-contain img { width: auto; max-width: 100%; max-height: 100%; }
  .f-phone { display: flex; flex-direction: column; gap: .8rem; }
  .f-phone img { max-width: 15rem; margin: 0 auto; }
  figcaption { display: block; margin-top: .8rem; max-width: 76ch; }
  .f-phone figcaption { margin-top: 0; }
  .cover figcaption { margin-top: .9rem; max-width: 70ch; font-size: .74rem; }
  .fig-label { display: block; margin-bottom: .2rem; font-weight: 400; color: var(--fg); text-transform: uppercase; letter-spacing: .06em; }
</style>
