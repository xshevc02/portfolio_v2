---
/** Large survey percentages with an explanation underneath. */
interface Props { items: { value: string; text: string }[] }
const { items } = Astro.props;
---
<section class="stats wrap">
  <div class="grid">
    {items.map((item) => (
      <div class="cell">
        <span class="value head">{item.value}</span>
        <span class="text">{item.text}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .grid { display: flex; flex-wrap: wrap; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .cell { flex: 1 1 16rem; display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--surface); }
  .value { font-size: clamp(3.5rem, 7vw, 6.5rem); color: var(--accent); }
  .text { font-size: 1rem; line-height: 1.55; }
</style>
