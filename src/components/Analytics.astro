---
// Microsoft Clarity: heatmaps, scroll depth and session recordings.
// Runs only in the production build, so local dev visits aren't recorded.
// Cookieless: storage consent is denied up front (also switch Cookies off in the Clarity project settings).
const CLARITY_ID = 'z27bty8wxs';
---
{import.meta.env.PROD && (
  <>
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', CLARITY_ID);
      window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
    </script>
    <script>
      // Named events for the clicks that matter, so they can be filtered in Clarity
      // (page-to-page journeys aren't stitched together without cookies).
      const track = (name: string) => (window as any).clarity?.('event', name);

      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest('a, [data-copy-email]');
        if (!el) return;
        if (el.hasAttribute('data-copy-email')) return track('email_copy');

        const href = (el as HTMLAnchorElement).href;
        if (!href) return;
        const url = new URL(href, location.href);
        if (url.protocol === 'mailto:') return track('email_click');
        if (url.hostname === 'docs.google.com') return track('cv_open');
        if (url.hostname === 'github.com') return track('github_open');
        if (url.origin !== location.origin) return track('external_link');

        const caseSlug = url.pathname.match(/\/work\/([^/]+)\/?$/)?.[1];
        if (caseSlug) return track(`case_open_${caseSlug.replace(/-/g, '_')}`);
        if (/\/brain\/?$/.test(url.pathname)) return track('brain_open');
        if (/\/kisk\/?$/.test(url.pathname)) return track('kisk_open');
      });
    </script>
  </>
)}
