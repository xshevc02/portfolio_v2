---
import type { ComponentProps } from 'astro/types';
import '../styles/system.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** Whole page on the blue .print surface (Thermo Fisher). */
  print?: boolean;
  header?: ComponentProps<typeof Header>;
  footer?: ComponentProps<typeof Footer>;
}
const {
  title,
  description = 'Anna Shevchenko — UX designer for scientific and data-heavy products. Brno, open to Prague & remote EU.',
  lang = 'en',
  print = false,
  header = { variant: 'home' },
  footer = { variant: 'home' },
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class:list={{ print }}>
    <Header {...header}><slot name="header" /></Header>
    <main id="top">
      <slot />
    </main>
    <Footer {...footer} />
  </body>
</html>
