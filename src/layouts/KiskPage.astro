---
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';
import LangToggle from '../components/LangToggle.astro';
import Facts from '../components/Facts.astro';
import { url } from '../lib/url';
import { t as strings, type Lang } from '../lib/kisk-i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];

const intro = (await getCollection('kiskIntro')).find((e) => e.data.lang === lang)!;
const { Content: Intro } = await render(intro);

const subjects = (await getCollection('kiskSubjects'))
  .filter((s) => s.data.lang === lang)
  .sort((a, b) => a.data.semester - b.data.semester || (a.data.order ?? 0) - (b.data.order ?? 0) || a.data.title.localeCompare(b.data.title));
const rendered = await Promise.all(subjects.map(async (s) => ({ entry: s, Content: (await render(s)).Content })));

const semesters = t.sem.map((name, i) => ({
  n: i + 1,
  name,
  subjects: rendered.filter((s) => s.entry.data.semester === i + 1),
}));
const years = t.years.map((label, y) => ({ label, span: t.spans[y], semesters: semesters.slice(y * 2, y * 2 + 2) }));
let counter = 0;
---
<Base
  title={`${t.title} — Anna Shevchenko`}
  lang={lang}
  header={{ variant: 'back', backHref: url('/#about'), backLabel: t.back }}
  footer={{ variant: 'email', text: 'Anna Shevchenko · KISK MUNI' }}
>
  <LangToggle slot="header" lang={lang} />

  <section class="intro wrap">
    <p class="label">{t.eyebrow}</p>
    <h1 class="head">{t.title}</h1>
    <div class="cols auto-grid">
      <div class="col">
        <p class="label col-label">{intro.data.title}</p>
        <div class="questions"><Intro /></div>
      </div>
      <div class="col">
        <p class="label col-label">{t.studyLabel}</p>
        <Facts items={[{ label: t.programmeLabel, value: t.programme }, { label: t.lengthLabel, value: t.length }]} />
      </div>
    </div>
  </section>

  <section class="overview wrap">
    <p class="label section-label">{t.overview}</p>
    <div class="years">
      {years.map((year) => (
        <div class="year">
          <div class="year-bar">
            <span class="head">{year.label}</span>
            <span class="span">{year.span}</span>
          </div>
          <ol class="sems">
            {year.semesters.map((s) => (
              <li>
                <span class="sem-n">{s.n} →</span>
                <span class="head">{s.name}</span>
                <span class="sem-count">{t.semesterCount(s.subjects.length)}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="subjects wrap">
    <div class="subjects-head">
      <h2 class="head">{t.subjects}</h2>
      <span class="count">{t.subjectsCount(subjects.length)}</span>
    </div>
    {semesters.map((sem) => (
      <div class="semester">
        <p class="label sem-label">{sem.n} → {sem.name}</p>
        {sem.subjects.length === 0 ? (
          <p class="placeholder">{t.empty}</p>
        ) : (
          sem.subjects.map(({ entry, Content }) => (
            <article class="subject">
              <div class="subject-side">
                <span class="num">{++counter}</span>
                <h3 class="head">{entry.data.title}</h3>
                <span class="label">{sem.name} · {entry.data.code}</span>
              </div>
              <div class="subject-main">
                <div class="reflection prose"><Content /></div>
                {entry.data.artefact && (
                  <figure class="artefact"><img src={url(entry.data.artefact)} alt={entry.data.artefactAlt ?? ''} loading="lazy" /></figure>
                )}
                {entry.data.links && (
                  <div class="links">
                    <span class="label">{t.linksLabel}</span>
                    <ul>
                      {entry.data.links.map((link) => <li><a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a></li>)}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          ))
        )}
      </div>
    ))}
  </section>

  <section class="summary wrap print">
    <div class="case-cols">
      <p class="side label">{t.summaryLabel}</p>
      <div class="main">
        <h2 class="h2 head">{t.summaryTitle}</h2>
        <p class="summary-empty">{t.summaryEmpty}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .label { margin: 0; }

  /* intro */
  .intro { padding-block: clamp(2.5rem, 5vw, 5rem) clamp(2rem, 4vw, 3.5rem); }
  h1 { margin: clamp(1.25rem, 2.5vw, 2rem) 0 0; max-width: 18ch; font-size: clamp(2.6rem, 6.4vw, 6.2rem); line-height: .88; }
  .cols { --min: 22rem; --gap: clamp(2rem, 5vw, 5rem); align-items: start; margin-top: clamp(2rem, 4vw, 3.5rem); }
  .col { display: flex; flex-direction: column; gap: 1rem; }
  .col-label { font-size: .72rem; }
  .col :global(.facts) { border-top-color: var(--line); }
  .questions { counter-reset: q; display: flex; flex-direction: column; }
  .questions :global(h2) {
    counter-increment: q;
    margin: 0; padding-top: 1.1rem; border-top: 1px solid var(--line);
    font-family: var(--font-head); font-stretch: 78%; font-weight: 800; text-transform: uppercase;
    font-size: 1.35rem; line-height: .95; letter-spacing: -.015em;
  }
  .questions :global(h2::before) { content: counter(q) ' '; color: var(--accent); }
  .questions :global(p) { margin: .7rem 0 1.25rem; max-width: 64ch; font-size: 1.02rem; line-height: 1.7; color: var(--fg-body); text-wrap: pretty; }

  /* semester overview */
  .overview { padding-top: clamp(2rem, 4vw, 3rem); }
  .section-label { margin-bottom: 1.25rem; font-size: .72rem; letter-spacing: .09em; }
  .years { display: flex; flex-wrap: wrap; gap: clamp(1rem, 2vw, 1.5rem); }
  .year { flex: 1 1 22rem; min-width: 0; display: flex; flex-direction: column; }
  .year-bar { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .8rem 1rem; background: var(--cobalt); color: var(--on-print); }
  .year-bar .head { flex: 0 0 auto; font-size: 1.3rem; line-height: 1; white-space: nowrap; }
  .span { font: 400 .74rem/1 var(--font-mono); color: var(--on-print-label); }
  .sems { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 1px; background: var(--line); border: 1px solid var(--line); border-top: 0; }
  .sems li { flex: 1 1 10rem; display: flex; flex-direction: column; gap: .6rem; padding: clamp(1.1rem, 2vw, 1.5rem); background: var(--paper); }
  .sem-n { font: 400 .72rem/1 var(--font-mono); color: var(--accent); }
  .sems .head { font-size: 1.4rem; }
  .sem-count { font: 400 .74rem/1.5 var(--font-mono); color: var(--fg-soft); }

  /* subjects */
  .subjects { padding-top: clamp(4rem, 8vw, 6rem); }
  .subjects-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  .subjects-head h2 { margin: 0; font-size: clamp(1.9rem, 3.6vw, 3.4rem); }
  .count { font: 400 .74rem/1 var(--font-mono); color: var(--accent); }
  .semester { padding-top: clamp(1.5rem, 3vw, 2rem); }
  .sem-label { font-size: .72rem; }
  .placeholder { margin: 1rem 0 0; padding: 1.25rem; border: 1px dashed var(--cobalt); font: 400 .8rem/1.6 var(--font-mono); color: var(--accent); }
  .subject { display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 4vw, 4rem); padding: clamp(2rem, 4vw, 3rem) 0; border-bottom: 1px solid var(--line); }
  .subject-side { flex: 1 1 13rem; min-width: 0; display: flex; flex-direction: column; gap: .6rem; }
  .subject-side h3 { margin: 0; font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: .92; }
  .subject-main { flex: 999 1 26rem; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .reflection { grid-column: 1 / -1; }
  .artefact { margin: 0; display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; padding: 1rem; background: var(--matte); border: 1px solid var(--line); }
  .artefact img { max-width: 100%; max-height: 100%; display: block; }
  .links { display: flex; flex-direction: column; }
  .links .label { padding-bottom: .6rem; font-size: .72rem; }
  .links ul { margin: 0; padding: 0; list-style: none; }
  .links li { border-top: 1px solid var(--line); }
  .links li:last-child { border-bottom: 1px solid var(--line); }
  .links a { display: block; padding: .8rem 0; font: 400 .8rem/1.5 var(--font-mono); }

  /* year summary */
  .summary { margin-top: clamp(4rem, 8vw, 6rem); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .summary .side { font-size: .74rem; }
  .summary h2 { max-width: 20ch; }
  .summary-empty { margin: 0; min-height: 9rem; padding: 1.25rem; border: 1px dashed var(--fg-soft); font: 400 .8rem/1.6 var(--font-mono); color: var(--accent); }
</style>
